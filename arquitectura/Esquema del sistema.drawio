ometry></mxCell><mxCell id="futuro-26" value="reparte" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="futuro-15" target="futuro-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="futuro-27" value="ejecuta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="futuro-16" target="futuro-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="futuro-28" value="IA (por fases, siempre opcional)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fillColor=#f6f0f9;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="380" height="420" as="geometry"/></mxCell><mxCell id="futuro-29" value="&lt;b&gt;Hoy&lt;/b&gt; · sin IA&lt;br&gt;todo determinista y explicable" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1225" y="160" width="330" height="75" as="geometry"/></mxCell><mxCell id="futuro-30" value="&lt;b&gt;Prueba gratuita&lt;/b&gt; · Ollama en tu PC&lt;br&gt;(RTX 4060, 8 GB)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1225" y="280" width="330" height="85" as="geometry"/></mxCell><mxCell id="futuro-31" value="&lt;b&gt;Con ingresos&lt;/b&gt; · Claude en AWS Bedrock (UE)&lt;br&gt;sin retención de datos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1225" y="410" width="330" height="90" as="geometry"/></mxCell><mxCell id="futuro-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="futuro-29" target="futuro-30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="futuro-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="futuro-30" target="futuro-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="futuro-34" value="solo lo que la ejecución&lt;br&gt;no resuelve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="futuro-16" target="futuro-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="futuro-35" value="Por qué así" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1200" y="560" width="380" height="175" as="geometry"/></mxCell><mxCell id="futuro-36" value="• El servidor nunca ve nombres: se cambian en el navegador.&lt;br&gt;• Escalar = más workers, no reescribir.&lt;br&gt;• Sin coste hasta que haya ingresos.&lt;br&gt;• Docker hace que «en mi PC funciona» valga también en el servidor." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1215" y="600" width="350" height="150" as="geometry"/></mxCell><mxCell id="futuro-37" value="&lt;b&gt;Hoy · Fase 1&lt;/b&gt;&lt;br&gt;todo en tu PC · 0 € · sin interfaz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="480" height="70" as="geometry"/></mxCell><mxCell id="futuro-38" value="&lt;b&gt;Piloto · Fases 2-3&lt;/b&gt;&lt;br&gt;Cotejo (anonimizar, calibrar, recuperar): falta probarlo con el profesor" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="570" y="930" width="480" height="70" as="geometry"/></mxCell><mxCell id="futuro-39" value="&lt;b&gt;Escala&lt;/b&gt;&lt;br&gt;servidor en la UE + más workers · mismo código" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1100" y="930" width="480" height="70" as="geometry"/></mxCell><mxCell id="futuro-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="futuro-37" target="futuro-38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="futuro-41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="futuro-38" target="futuro-39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>